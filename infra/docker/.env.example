# Copy to infra/docker/.env before `docker compose up`.
#
#   openssl rand -hex 32   (run it three times, one value each)

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts MT5 passwords at rest. Losing it means re-entering every broker
# password; changing it means re-encrypting them all.
MT5_CRED_KEY=

# Point at the connector running natively on Windows. For the mock profile,
# use http://mt5-connector-mock:8001 instead.
MT5_CONNECTOR_URL=http://host.docker.internal:8001

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
